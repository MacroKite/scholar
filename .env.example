# Postgres connection string (Neon, Vercel Postgres, Supabase, a local server…).
# Leave it unset for local development to use the built-in PGlite database in .data/pglite.
DATABASE_URL=

# Optional
# DEMO_PASSWORD=scholar123          # starting password for every seeded account
# SHOW_DEMO_ACCOUNTS=false          # hide the demo logins on the sign-in page
# SCHOOL_TIMEZONE=Asia/Dhaka        # decides what "today" is on the server

# SMS to guardians through BulkSMSBD (bulksmsbd.net). Without these, SMS are
# kept in the outbox (admin → SMS) but not sent.
# BULKSMSBD_API_KEY=
# BULKSMSBD_SENDER_ID=
